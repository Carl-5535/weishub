[
  {
    "name": "claude",
    "detect": "claude",
    "run": ["claude", "-p", "--output-format", "json"],
    "passVia": "stdin",
    "outputFormat": "claude-json",
    "listSessions": { "store": "~/.claude/projects", "kind": "claude" },
    "resume": ["--resume", "{{sessionId}}"],
    "approval": "permission-prompt-tool",
    "permissionFlags": {
      "auto": ["--permission-mode", "acceptEdits"],
      "full": ["--dangerously-skip-permissions"]
    },
    "workspace": null,
    "timeoutSec": 1800
  },
  {
    "name": "codex",
    "detect": "codex",
    "run": ["codex", "exec", "--json"],
    "passVia": "stdin",
    "outputFormat": "codex-jsonl",
    "listSessions": { "store": "~/.codex/sessions", "kind": "codex" },
    "resumeRun": ["codex", "exec", "resume", "{{sessionId}}", "--json"],
    "approval": "app-server",
    "permissionFlags": {
      "auto": [],
      "full": ["--dangerously-bypass-approvals-and-sandbox"]
    },
    "workspace": null,
    "timeoutSec": 1800
  },
  {
    "$note": "已按本机 `dsh headless --help` 校准：任务走 stdin，--session-id <id> 恢复会话",
    "name": "dsh",
    "detect": "dsh",
    "run": ["dsh", "--profile", "headless"],
    "passVia": "stdin",
    "outputFormat": "text",
    "resume": ["--session-id", "{{sessionId}}"],
    "approval": null,
    "permissionFlags": { "auto": [], "full": [] },
    "workspace": null,
    "timeoutSec": 1800
  },
  {
    "$note": "已按本机 opencode v2.0.32 实测校准：run --format json 事件流，--session <id> 恢复会话。模型默认用内置免费档（opencode/glm-5.3-flash-free），用户可在 agents.d 覆盖 -m 参数",
    "name": "opencode",
    "detect": "opencode",
    "run": ["opencode", "run", "--format", "json", "-m", "opencode/glm-5.3-flash-free"],
    "passVia": "stdin",
    "outputFormat": "opencode-jsonl",
    "resumeRun": ["opencode", "run", "--format", "json", "-m", "opencode/glm-5.3-flash-free", "--session", "{{sessionId}}"],
    "approval": null,
    "permissionFlags": { "auto": ["--auto"], "full": ["--auto"] },
    "workspace": null,
    "timeoutSec": 1800
  },
  {
    "$note": "执行时以实际 CLI 输出校准；该 agent v1 不支持会话恢复",
    "name": "pi",
    "detect": "pi",
    "run": ["pi"],
    "passVia": "stdin",
    "outputFormat": "text",
    "approval": null,
    "permissionFlags": { "auto": [], "full": [] },
    "workspace": null,
    "timeoutSec": 1800
  }
]

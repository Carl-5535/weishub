[
  {
    "name": "claude",
    "detect": "claude",
    "run": ["claude", "-p", "--output-format", "json"],
    "passVia": "stdin",
    "outputFormat": "claude-json",
    "listSessions": { "store": "~/.claude/projects", "kind": "claude" },
    "resume": ["--resume", "{{sessionId}}"],
    "approval": "permission-prompt-tool",
    "permissionFlags": {
      "auto": ["--permission-mode", "acceptEdits"],
      "full": ["--dangerously-skip-permissions"]
    },
    "workspace": null,
    "timeoutSec": 1800
  },
  {
    "name": "codex",
    "detect": "codex",
    "run": ["codex", "exec", "--json"],
    "passVia": "stdin",
    "outputFormat": "codex-jsonl",
    "listSessions": { "store": "~/.codex/sessions", "kind": "codex" },
    "resumeRun": ["codex", "exec", "resume", "{{sessionId}}", "--json"],
    "approval": "app-server",
    "permissionFlags": {
      "auto": [],
      "full": ["--dangerously-bypass-approvals-and-sandbox"]
    },
    "workspace": null,
    "timeoutSec": 1800
  },
  {
    "$note": "resume 已按本机 dsh headless --help 校准（--session-id <id> 恢复既有会话）",
    "name": "dsh",
    "detect": "dsh",
    "run": ["dsh", "agent", "run"],
    "passVia": "stdin",
    "outputFormat": "text",
    "resume": ["--session-id", "{{sessionId}}"],
    "approval": null,
    "permissionFlags": { "auto": [], "full": [] },
    "workspace": null,
    "timeoutSec": 1800
  },
  {
    "$note": "执行时以实际 CLI 输出校准；该 agent v1 不支持会话恢复",
    "name": "pi",
    "detect": "pi",
    "run": ["pi"],
    "passVia": "stdin",
    "outputFormat": "text",
    "approval": null,
    "permissionFlags": { "auto": [], "full": [] },
    "workspace": null,
    "timeoutSec": 1800
  }
]

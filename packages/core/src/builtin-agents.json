[
  {
    "name": "claude",
    "detect": "claude",
    "run": [
      "claude",
      "-p",
      "--output-format",
      "json"
    ],
    "passVia": "stdin",
    "outputFormat": "claude-json",
    "listSessions": {
      "store": "~/.claude/projects",
      "kind": "claude"
    },
    "resume": [
      "--resume",
      "{{sessionId}}"
    ],
    "approval": "permission-prompt-tool",
    "permissionFlags": {
      "auto": [
        "--permission-mode",
        "acceptEdits"
      ],
      "full": [
        "--dangerously-skip-permissions"
      ]
    },
    "workspace": null,
    "timeoutSec": 1800
  },
  {
    "name": "codex",
    "detect": "codex",
    "run": [
      "codex",
      "exec",
      "--json",
      "--skip-git-repo-check"
    ],
    "passVia": "stdin",
    "outputFormat": "codex-jsonl",
    "listSessions": {
      "store": "~/.codex/sessions",
      "kind": "codex"
    },
    "resumeRun": [
      "codex",
      "exec",
      "resume",
      "{{sessionId}}",
      "--json"
    ],
    "approval": "app-server",
    "permissionFlags": {
      "auto": [],
      "full": [
        "--dangerously-bypass-approvals-and-sandbox"
      ]
    },
    "workspace": null,
    "timeoutSec": 1800,
    "$note": "已按本机 codex 0.163.0 实测校准：exec --json 事件流（thread.started/item.completed），prompt 走 stdin（argv 会触发 Reading additional from stdin 前缀），--skip-git-repo-check 非必带。注意：resume 子命令不支持 -s/-C，故 auto 沙箱 flag 留空（用 codex 默认），full 用 bypass（resume 可用）"
  },
  {
    "$note": "已按本机 `dsh headless --help` 校准：任务走 stdin，--session-id <id> 恢复会话",
    "name": "dsh",
    "detect": "dsh",
    "run": [
      "dsh",
      "--profile",
      "headless"
    ],
    "passVia": "stdin",
    "outputFormat": "text",
    "resume": [
      "--session-id",
      "{{sessionId}}"
    ],
    "approval": null,
    "permissionFlags": {
      "auto": [],
      "full": []
    },
    "workspace": null,
    "timeoutSec": 1800
  },
  {
    "$note": "已按本机 opencode v2.0.32 实测校准：run --format json 事件流，--session <id> 恢复会话。模型默认用内置免费档（opencode/glm-5.3-flash-free），用户可在 agents.d 覆盖 -m 参数",
    "name": "opencode",
    "detect": "opencode",
    "run": [
      "opencode",
      "run",
      "--format",
      "json",
      "-m",
      "opencode/glm-5.3-flash-free"
    ],
    "passVia": "stdin",
    "outputFormat": "opencode-jsonl",
    "resumeRun": [
      "opencode",
      "run",
      "--format",
      "json",
      "-m",
      "opencode/glm-5.3-flash-free",
      "--session",
      "{{sessionId}}"
    ],
    "approval": null,
    "permissionFlags": {
      "auto": [
        "--auto"
      ],
      "full": [
        "--auto"
      ]
    },
    "workspace": null,
    "timeoutSec": 1800
  },
  {
    "$note": "已按本机 pi v0.73.1 实测校准：-p --mode json，--session <uuid> 恢复。pi 无内置免费 provider，需要自备 key（ANTHROPIC_API_KEY / GEMINI_API_KEY / OPENROUTER_API_KEY 等，见 pi --help 尾部）",
    "name": "pi",
    "detect": "pi",
    "run": [
      "pi",
      "-p",
      "--mode",
      "json"
    ],
    "passVia": "stdin",
    "outputFormat": "pi-jsonl",
    "resume": [
      "--session",
      "{{sessionId}}"
    ],
    "approval": null,
    "permissionFlags": {
      "auto": [],
      "full": []
    },
    "workspace": null,
    "timeoutSec": 1800
  }
]
{
  "name": "weishub-monorepo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/*"
  ],
  "bin": {
    "weishub": "packages/weishub/lib/cli.js",
    "wx": "packages/weishub/lib/wx.js"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc -b packages/channel-wechat packages/core packages/weishub",
    "build": "tsc -b packages/channel-wechat packages/core packages/weishub && node scripts/fix-exec-bits.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/qrcode": "^1.5.6",
    "typescript": "^5.6.0",
    "vitest": "^3.2.0"
  }
}
